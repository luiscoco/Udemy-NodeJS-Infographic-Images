{
  "name": "nodejs-practical-examples",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.13.1 <27"
  },
  "workspaces": [
    "lessons/*"
  ],
  "scripts": {
    "lesson": "node tools/run.mjs",
    "catalog": "node tools/run.mjs --list",
    "validate": "node tools/validate.mjs",
    "test": "node --test test/*.test.mjs",
    "setup": "node tools/setup.mjs",
    "check": "node tools/check.mjs",
    "validate:services": "node tools/validate.mjs --services",
    "validate:docker": "node tools/validate.mjs --docker",
    "api": "node applications/task-api/server.mjs",
    "worker": "node applications/report-worker/main.mjs",
    "rooms": "node applications/rooms/main.mjs",
    "logtool": "node applications/logtool/main.mjs",
    "index": "node tools/build-index.mjs"
  },
  "dependencies": {
    "@fastify/cors": "11.4.3",
    "@fastify/csrf-protection": "8.0.2",
    "@fastify/multipart": "10.1.9",
    "@fastify/rate-limit": "11.3.0",
    "@fastify/secure-session": "8.4.2",
    "@fastify/static": "10.1.12",
    "@fastify/swagger": "9.9.5",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/instrumentation": "0.301.2",
    "@opentelemetry/sdk-node": "0.301.2",
    "@opentelemetry/sdk-trace": "3.1.1",
    "bullmq": "6.7.10",
    "express": "5.3.0",
    "fastify": "5.12.8",
    "ioredis": "6.1.0",
    "jose": "6.2.18",
    "mongodb": "7.9.1",
    "node-pg-migrate": "9.0.0",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "piscina": "5.3.2",
    "prom-client": "15.1.3",
    "redis": "6.4.0",
    "undici": "8.13.1",
    "ws": "8.23.0"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "@types/node": "26.6.10",
    "eslint": "10.15.0",
    "@eslint/js": "10.0.1",
    "prettier": "3.10.1",
    "esbuild": "0.28.2",
    "fast-check": "4.11.0",
    "node-gyp": "13.1.0",
    "node-addon-api": "8.9.2",
    "semver": "7.8.6",
    "wabt": "1.0.39"
  },
  "overrides": {
    "glob": "14.0.6"
  }
}
